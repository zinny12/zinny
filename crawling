# ══════════════════════════════════════════
# 크롤링 함수
# ══════════════════════════════════════════
def fetch_news(query, filter_title=False):
    """
    네이버 뉴스 검색 결과 크롤링.
    filter_title=True이면 제목에 query가 포함된 기사만 수집.
    """
    articles = []
    for n in PAGES:
        url = (
            "https://search.naver.com/search.naver"
            f"?where=news&sm=tab_opt&sort=0&pd=4&query={query}&start={n}"
        )
        try:
            resp = requests.get(url, timeout=10)
            soup = bs(resp.text, "html.parser")
            items = soup.select("ul.list_news > li")

            for item in items:
                title_tag = item.select_one("div.news_area > a")
                link_tag = item.select_one("a.news_tit")
                if not title_tag or not link_tag:
                    continue

                title = title_tag.text.strip()
                link = link_tag.get("href")

                # 밸류체인 종목은 제목에 종목명 포함된 것만
                if filter_title and query not in title:
                    continue

                # 마크다운 깨짐 방지
                clean_title = title.replace("[", "").replace("]", " - ")
                articles.append(f"[{clean_title}]({link})")

        except Exception as e:
            print(f"[ERROR] {query} page {n}: {e}")

        time.sleep(DELAY)

    return articles


# ══════════════════════════════════════════
# 메시지 조립
# ══════════════════════════════════════════
def build_message():
    sections = []

    # ── Part 1: 산업 키워드 ──
    industry_lines = []
    for kw in INDUSTRY_KEYWORDS:
        print(f"  크롤링: {kw}")
        articles = fetch_news(kw, filter_title=False)
        if articles:
            industry_lines.append(f"▶ {kw}")
            industry_lines.extend(articles)
            industry_lines.append("")  # 빈 줄 구분

    if industry_lines:
        sections.append("━━━━━━━━━━━━━━━━━━━━")
        sections.append("📡 *산업 키워드 뉴스*")
        sections.append("━━━━━━━━━━━━━━━━━━━━")
        sections.extend(industry_lines)

    # ── Part 2: 밸류체인 종목 ──
    for category, companies in VALUE_CHAIN.items():
        cat_lines = []
        for company in companies:
            print(f"  크롤링: {company}")
            articles = fetch_news(company, filter_title=True)
            if articles:
                cat_lines.append(f"▶ {company}")
                cat_lines.extend(articles)
                cat_lines.append("")

        if cat_lines:
            sections.append(f"\n[{category}]")
            sections.extend(cat_lines)

    if not sections:
        return None

    return "\n".join(sections)


# ══════════════════════════════════════════
# 텔레그램 전송
# ══════════════════════════════════════════
async def send_telegram(message):
    """
    텔레그램 메시지 전송. 4096자 초과 시 자동 분할.
    """
    MAX_LEN = 4096
    chunks = []

    # 줄 단위로 분할해서 4096자 이내로 묶기
    current = ""
    for line in message.split("\n"):
        if len(current) + len(line) + 1 > MAX_LEN:
            chunks.append(current)
            current = line
        else:
            current = current + "\n" + line if current else line
    if current:
        chunks.append(current)

    for i, chunk in enumerate(chunks, 1):
        try:
            await bot.send_message(
                chat_id=CHAT_ID,
                text=chunk,
                disable_web_page_preview=True,
                parse_mode="Markdown",
            )
            print(f"  ✓ 메시지 {i}/{len(chunks)} 전송 완료")
            if i < len(chunks):
                await asyncio.sleep(1)  # rate limit 방지
        except Exception as e:
            print(f"  ✗ 메시지 {i} 전송 실패: {e}")


